# copy to .env and fill in. never commit .env.

# a paid rpc is strongly recommended (helius, triton, quicknode)
RPC_URL=https://api.mainnet-beta.solana.com

# the keeper's wallet secret key, base58. this wallet should be the coin creator
# (or the address the creator fees are routed to). keep only working sol in it.
KEEPER_SECRET=

# the $STAY mint address
MINT=

# who the creator fees belong to. leave empty if it's the keeper wallet itself.
CREATOR=

# safety: true = plan every step and log it, send nothing. flip to false only after a dry run looks right.
DRY_RUN=true

# how often to run a batch, in seconds
INTERVAL_SEC=300

# don't bother below this much spendable sol
MIN_BATCH_SOL=0.05

# sol always left in the wallet for network fees
SOL_KEEP=0.05

# share of each batch that buys $STAY before pairing (about half keeps the add balanced)
BUY_SHARE=0.5

# the buried bone: % of supply the keeper holds and never sells
RESERVE_PCT=4

# share of a batch that tops up the bone when it's below RESERVE_PCT
REFILL_SHARE=0.25

# max slippage, percent
SLIPPAGE=1

# public log server (the bowl page reads http://host:PORT/log.json)
PORT=8787
LOG_FILE=data/log.json
